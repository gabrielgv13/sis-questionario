# Copie para .env.docker.local (ignorado pelo Git). Não substitua seu .env.
ADMIN_PASSWORD=troque-por-uma-senha-administrativa-forte
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
POSTGRES_PASSWORD=troque-por-uma-senha-forte-do-provisionador
# DB_PASSWORD é gerada automaticamente no volume de segredos.

# Alternatively, leave ADMIN_PASSWORD empty and set ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD_HASH=hash-gerado-com-werkzeug
# Uvicorn: one process by default; reload is disabled in containers.
WEB_WORKERS=1
WEB_SHUTDOWN_TIMEOUT=30
WEB_STOP_GRACE_PERIOD=45s
COOKIE_SECURE=0
TRUST_PROXY=0
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Each web process owns its async pool.
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=2
DB_POOL_TIMEOUT=5
DB_POOL_MAX_WAITING=32
# Rollback to clean-<commit> / test-<commit>: set -<commit> and use --no-build.
IMAGE_SUFFIX=
