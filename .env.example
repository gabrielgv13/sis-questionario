DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=postgres
DB_PASSWORD=postgres
SECRET_KEY=preencha-com-uma-chave-aleatoria

# Website admin login (independent of PostgreSQL credentials).
# Generate with: uv run python -c "from getpass import getpass; from werkzeug.security import generate_password_hash; print(generate_password_hash(getpass('Admin password: ')))"
# ADMIN_PASSWORD_HASH=paste-generated-hash-here

# Optional administrator overrides for database setup:
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=postgres
# Psycopg connects directly; PSQL_PATH is not needed.

# Local Uvicorn server. Reload requires WEB_WORKERS=1.
WEB_HOST=127.0.0.1
PORT=5000
WEB_WORKERS=1
WEB_RELOAD=0
WEB_SHUTDOWN_TIMEOUT=30
# Enable only behind a trusted reverse proxy; list its source IPs/networks.
TRUST_PROXY=0
FORWARDED_ALLOW_IPS=127.0.0.1,::1
COOKIE_SECURE=0
# Every web worker owns an async pool. CLI/provisioning use sync connections.
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=2
DB_POOL_TIMEOUT=5
DB_POOL_MAX_WAITING=32
