DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=client-app
DB_PASSWORD=preencha-com-a-senha-do-usuario
SECRET_KEY=preencha-com-uma-chave-aleatoria

# Hash Werkzeug da senha da análise. Vazio mantém o acesso desabilitado.
ADMIN_PASSWORD_HASH=
# Use true quando servir por HTTPS; no localhost HTTP, mantenha false.
SESSION_COOKIE_SECURE=false

# Administrador usado apenas para preparar o banco.
DB_ADMIN_USER=postgres

# Opcional: caminho completo do executável psql, se não estiver no PATH.
# PSQL_PATH=C:/Program Files/PostgreSQL/18/bin/psql.exe
